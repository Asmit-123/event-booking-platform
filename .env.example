# Generate a fresh key locally; never commit a real SECRET_KEY.
SECRET_KEY=replace-with-a-new-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Number of trusted reverse proxies in front of the app (0 when running locally).
TRUSTED_PROXY_COUNT=0

# Production only: set these in your hosting provider's environment settings.
# ALLOWED_HOSTS=your-project.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app
# DJANGO_SETTINGS_MODULE=config.settings.production
# Use Neon's pooled URL for DATABASE_URL at runtime.
# Use Neon's direct/unpooled URL for one-off database migrations.
# SECURE_HSTS_SECONDS=3600

# Email: leave EMAIL_BACKEND unset locally (emails print to the terminal).
# Production example with Resend SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=your-resend-api-key
# DEFAULT_FROM_EMAIL=Event Booking <noreply@your-verified-domain.com>